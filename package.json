{
  "name": "ultima-online",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ClassicUO web client scripts",
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "types": "node scripts/fetch-types.mjs && node scripts/patch-types.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  }
}
